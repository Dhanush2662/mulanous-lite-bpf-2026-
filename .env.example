# Optional. When OPENAI_API_KEY is set, POST /api/analyze uses OpenAI structured outputs.
# The model must support json_schema response_format (gpt-4o-mini does).
# When the key is empty, the process uses the deterministic evidence reader and makes no network call.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional embeddings for semantic evidence (Slack, meetings, quality notes).
# When OPENAI_API_KEY is empty, the process uses a deterministic local embedder.
# Dimension must match the Atlas vector index (default 64).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=64

# Optional MongoDB Atlas evidence store. Leave MONGODB_URI empty to use in-memory fixtures.
# Never commit a real URI. The process does not log this value.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=mulanous_lite
ATLAS_VECTOR_INDEX=evidence_vector
